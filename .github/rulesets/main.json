{
  "name": "main-ci",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "clang-format"},
          {"context": "actionlint"},
          {"context": "windows-msvc-Release"},
          {"context": "windows-msvc-Debug"},
          {"context": "windows-mingw-Release"}
        ]
      }
    }
  ]
}
