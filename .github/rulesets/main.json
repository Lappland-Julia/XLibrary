{
  "name": "main-ci",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "clang-format"},
          {"context": "actionlint"},
          {"context": "windows-msvc-Release"},
          {"context": "windows-msvc-Debug"},
          {"context": "windows-mingw-Release"},
          {"context": "windows-mingw-Debug"},
          {"context": "linux-debug"},
          {"context": "linux-release"},
          {"context": "linux-clang-debug"},
          {"context": "linux-clang-release"},
          {"context": "linux-AppImage-and-DEB"},
          {"context": "Analyze (actions)"},
          {"context": "Analyze (c-cpp)"}
        ]
      }
    }
  ]
}
