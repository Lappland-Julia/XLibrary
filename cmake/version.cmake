# Полная версия выпуска, включая prerelease/build, берётся только из VERSION.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../VERSION")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../VERSION" XLIBRARY_RELEASE_VERSION)
string(STRIP "${XLIBRARY_RELEASE_VERSION}" XLIBRARY_RELEASE_VERSION)

set(xlibrary_semver_number "(0|[1-9][0-9]*)")
set(xlibrary_semver_identifier "[0-9A-Za-z-]+")
if(NOT XLIBRARY_RELEASE_VERSION MATCHES
        "^${xlibrary_semver_number}\\.${xlibrary_semver_number}\\.${xlibrary_semver_number}(-${xlibrary_semver_identifier}(\\.${xlibrary_semver_identifier})*)?(\\+${xlibrary_semver_identifier}(\\.${xlibrary_semver_identifier})*)?$")
    message(FATAL_ERROR "VERSION must contain a valid SemVer version (major.minor.patch[-prerelease][+build]).")
endif()
set(XLIBRARY_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(XLIBRARY_VERSION_MINOR "${CMAKE_MATCH_2}")
set(XLIBRARY_VERSION_PATCH "${CMAKE_MATCH_3}")
set(XLIBRARY_NUMERIC_VERSION "${XLIBRARY_VERSION_MAJOR}.${XLIBRARY_VERSION_MINOR}.${XLIBRARY_VERSION_PATCH}")
string(REGEX REPLACE "\\+.*$" "" xlibrary_version_without_build "${XLIBRARY_RELEASE_VERSION}")
string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.[0-9]+" "" xlibrary_prerelease "${xlibrary_version_without_build}")
set(XLIBRARY_IS_PRERELEASE FALSE)
set(XLIBRARY_WINDOWS_FILE_FLAGS "0")
set(XLIBRARY_DEBIAN_VERSION "${XLIBRARY_NUMERIC_VERSION}")
if(NOT xlibrary_prerelease STREQUAL "")
    set(XLIBRARY_IS_PRERELEASE TRUE)
    set(XLIBRARY_WINDOWS_FILE_FLAGS "VS_FF_PRERELEASE")
    string(SUBSTRING "${xlibrary_prerelease}" 1 -1 xlibrary_prerelease)
    string(REPLACE "." ";" xlibrary_prerelease_parts "${xlibrary_prerelease}")
    string(APPEND XLIBRARY_DEBIAN_VERSION "~")
    # Debian и SemVer по-разному сравнивают смешанные идентификаторы. Кодируем тип
    # и ASCII-порядок; завершающий ~ сохраняет порядок префиксов и списков.
    set(xlibrary_ascii_order "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")
    set(xlibrary_encoding_alphabet "abcdefghijklmnopqrstuvwxyz")
    foreach(xlibrary_part IN LISTS xlibrary_prerelease_parts)
        if(xlibrary_part MATCHES "^[0-9]+$")
            if(xlibrary_part MATCHES "^0[0-9]+$")
                message(FATAL_ERROR "Numeric SemVer prerelease identifiers must not contain leading zeroes.")
            endif()
            string(APPEND XLIBRARY_DEBIAN_VERSION "n${xlibrary_part}~")
        else()
            string(APPEND XLIBRARY_DEBIAN_VERSION "s")
            string(LENGTH "${xlibrary_part}" xlibrary_part_length)
            math(EXPR xlibrary_part_last "${xlibrary_part_length} - 1")
            foreach(xlibrary_index RANGE 0 ${xlibrary_part_last})
                string(SUBSTRING "${xlibrary_part}" ${xlibrary_index} 1 xlibrary_character)
                string(FIND "${xlibrary_ascii_order}" "${xlibrary_character}" xlibrary_code)
                math(EXPR xlibrary_high "${xlibrary_code} / 26")
                math(EXPR xlibrary_low "${xlibrary_code} % 26")
                string(SUBSTRING "${xlibrary_encoding_alphabet}" ${xlibrary_high} 1 xlibrary_high)
                string(SUBSTRING "${xlibrary_encoding_alphabet}" ${xlibrary_low} 1 xlibrary_low)
                string(APPEND XLIBRARY_DEBIAN_VERSION "${xlibrary_high}${xlibrary_low}")
            endforeach()
            string(APPEND XLIBRARY_DEBIAN_VERSION "~")
        endif()
    endforeach()
endif()
# Build metadata различает артефакты, но не влияет на приоритет SemVer/Debian.
set(XLIBRARY_WINDOWS_NUMERIC_VERSION "${XLIBRARY_NUMERIC_VERSION}.0")
