---
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120

BreakBeforeBraces: Attach
AccessModifierOffset: -4
NamespaceIndentation: None
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Right
ReflowComments: false
FixNamespaceComments: false
MaxEmptyLinesToKeep: 1
LineEnding: LF

SortIncludes: CaseInsensitive
IncludeBlocks: Regroup
IncludeCategories:
  # windows.h must precede the other Windows SDK headers.
  - Regex: '^[<"]windows\.h[>"]$'
    Priority: -30
    SortPriority: -40
  - Regex: '^[<"](objbase|shellapi|tlhelp32|winver)\.h[>"]$'
    Priority: -30
    SortPriority: -30
  # Linux/POSIX and X11 system headers precede C++ and Qt headers.
  - Regex: '^<(sys/.*|linux/.*|X11/.*|xcb/.*|unistd\.h|dirent\.h|fcntl\.h|signal\.h|spawn\.h|poll\.h|pwd\.h)>'
    Priority: -30
    SortPriority: -30
  # Include standard library headers and other external dependencies with <>.
  - Regex: '^<'
    Priority: -20
  # Priority 0 groups project headers with the automatically detected main header.
  - Regex: '^"'
    Priority: 0
